# HTTP to HTTPS redirect
server {
    listen 80;
    server_name markdown.raspberry.lan;

    # Redirect all HTTP traffic to HTTPS
    return 301 https://$host$request_uri;
}

# HTTPS server block
server {
    listen 443 ssl http2;
    server_name markdown.raspberry.lan;

    ssl_certificate /var/www/certs/fullchain.pem;
    ssl_certificate_key /var/www/certs/server.key;
    ssl_protocols TLSv1.3;
    ssl_ciphers 'TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Content-Security-Policy "frame-ancestors 'none';" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    root /var/www/Markdown-Viewer;  # your site root
    index index.html;

    location ~ /\.(?!well-known).* {
        return 403;
    }

    # Static file caching for common assets
    location ~* \.(jpg|jpeg|png|gif|svg|css|js|woff|woff2)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # Main location block, serve files or 404
    location / {
        try_files $uri $uri/ =404;
    }
}
